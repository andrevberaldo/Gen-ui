# Live agent. Without this the app falls back to a scripted agent that still
# calls the real GitHub API and emits real A2UI messages.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# Optional: raises the GitHub API rate limit from 60 to 5000 requests/hour.
# GITHUB_TOKEN=ghp_...
